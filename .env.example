# ─────────────────────────────────────────────────────────────────────────────
# Procurement Platform — environment
#
# Copy to `.env` and fill in. A missing credential REFUSES TO BOOT, naming what
# is absent and where it comes from (SPEC §4.2). There is no degraded mode,
# because there is no committed snapshot of results to degrade into.
#
# `docker compose up` reads this file for every service.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Two variables, because Supabase fronts Postgres with Supavisor (SPEC §4.1):
#   DATABASE_URL         transaction pooler — the Next.js server components and
#                        route handlers. Drizzle over postgres.js needs
#                        `prepare: false` on this connection.
#   DIRECT_DATABASE_URL  direct/session — migrations, the seed, and the worker's
#                        `FOR UPDATE SKIP LOCKED` dequeue.
# Locally both point at the same Docker Postgres, so the split costs nothing in
# development and is correct in the one place it matters.
DATABASE_URL=postgres://procurement:procurement@localhost:5544/procurement
DIRECT_DATABASE_URL=postgres://procurement:procurement@localhost:5544/procurement

# ── Sayari ───────────────────────────────────────────────────────────────────
# OAuth2 client credentials from https://sayari.com — the entity graph, trade
# data, negative news and ownership traversal all come from here.
SAYARI_CLIENT_ID=
SAYARI_CLIENT_SECRET=

# ── Anthropic ────────────────────────────────────────────────────────────────
# Checked for presence, never for validity (SPEC §22.2 item 22): a wrong key
# surfaces as a failed Job rather than a refused boot, which is the cost of not
# spending on every cold start.
ANTHROPIC_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# The MCP server's Streamable HTTP transport refuses to start without this;
# stdio is unaffected because it trusts its parent process (SPEC §15.8).
MCP_BEARER=

# The Dossier is the one Managed Agents Job. Off in both environments.
DOSSIER_ENABLED=false

# Identifying User-Agent for Nominatim, which requires one by policy (SPEC §7.1).
NOMINATIM_USER_AGENT=procurement-platform/0.1 (contact: you@example.com)

# Worker tuning. Concurrency 4 is the number the run-budget overshoot was sized
# against (SPEC §18.3) — changing it changes the worst-case overshoot.
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
